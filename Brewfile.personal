# Personal-machine-only GUI apps. `chezmoi init` asks once ("Install
# personal apps?") so a work machine can skip them. The core Brewfile holds
# everything that should always be installed. The adopt args make brew take
# over a matching app that was installed by hand instead of failing with
# "already an App at /Applications/...".

# --- Casks ---
cask "iterm2", args: { adopt: true }
cask "craft", args: { adopt: true }
cask "zed", args: { adopt: true }
cask "spotify", args: { adopt: true }
cask "steam", args: { adopt: true }
cask "readdle-spark", args: { adopt: true }
cask "cleanshot", args: { adopt: true }
