#!/bin/bash
#
# Prints the setup steps that can't be automated.
set -euo pipefail

cat <<'EOF'

Remaining actions:

  * Barnata: already launched. Open Preferences from its menu bar item and
    grant all the necessary permissions.

  * iTerm2, Raycast, and Safari: import their settings from
    {{ .chezmoi.workingTree }}/imports, then restart iTerm2.

  * App Shortcuts: the rest of System Settings > Keyboard > Keyboard
    Shortcuts is restored, but not App Shortcuts. Add these.

      All Applications   Hide Messages             ⌘⌥⌃⇧\
                         Show Fonts                ⌘⌥⌃⇧\
      Finder             Downloads                 ⌘0
      Safari             Go To Next Tab Group      ⌘⌥↓
                         Go To Previous Tab Group  ⌘⌥↑
                         Hide Reader               ⌘⇧R
                         Show Reader               ⌘⇧R
                         Hide Safari               ⌘⌥⌃⇧\
                         Minimize                  ⌘⌥⌃⇧\
                         Minimize All              ⌘⌥⌃⇧\
                         Quit Safari               ⌘⌥⌃⇧\

EOF
