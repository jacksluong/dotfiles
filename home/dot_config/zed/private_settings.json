// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "gutter": {
    "breakpoints": false
  },
  "project_panel": {
    "hide_root": true,
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "bold_folder_labels": true,
    "default_width": 300.0
  },
  "redact_private_values": false,
  "diff_view_style": "split",
  "agent_ui_font_size": 15.0,
  "inline_code_actions": false,
  "completion_menu_item_kind": "symbol",
  "lsp_document_colors": "inlay",
  "code_lens": "off",
  "inlay_hints": {
    "show_background": false,
    "show_parameter_hints": true,
    "show_type_hints": false,
    "enabled": false
  },
  "show_completions_on_input": true,
  "tabs": {
    "git_status": false
  },
  "git_panel": {
    "fallback_branch_name": "main"
  },
  "proxy": "",
  "edit_predictions": {
    "mode": "eager",
    "allow_data_collection": "no"
  },
  "agent": {
    "show_turn_stats": false,
    "message_editor_min_lines": 4,
    "use_modifier_to_send": false,
    "thinking_display": "always_collapsed",
    "expand_terminal_card": false,
    "expand_edit_card": true,
    "sidebar_side": "right",
    "default_width": 480.0,
    "dock": "right",
    "play_sound_when_agent_done": "when_hidden",
    "favorite_models": [],
    "model_parameters": [],
    "auto_compact": {
      "threshold": "80%",
      "enabled": true
    }
  },
  "git": {
    "branch_picker": {
      "show_author_name": false
    },
    "inline_blame": {
      "enabled": false,
      "show_commit_summary": true,
      "delay_ms": 1000
    },
    "file_diff": {
      "show_full_file": false
    },
    "blame": {
      "show_avatar": false
    }
  },
  "title_bar": {
    "show_user_picture": false,
    "show_worktree_name": false,
    "show_branch_name": false,
    "show_menus": false,
    "show_sign_in": false,
    "show_branch_status_icon": false
  },
  "diagnostics": {
    "button": false
  },
  "debugger": {
    "button": true
  },
  "close_on_file_delete": true,
  "search": {
    "regex": false
  },
  "use_smartcase_search": true,
  "session": {
    "trust_all_worktrees": true
  },
  "terminal": {
    "font_size": 12.5,
    "toolbar": {
      "breadcrumbs": false
    },
    "copy_on_select": true,
    "env": {
      "FIG_NEW_SESSION": "\"1\""
    },
    "font_family": "FiraCode Nerd Font",
    "cursor_shape": "bar",
    "blinking": "on"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "status_bar": {
    "active_language_button": true,
    "experimental.show": false
  },
  "tab_bar": {
    "show": false,
    "show_tab_bar_buttons": false
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": false,
  "sticky_scroll": {
    "enabled": true
  },
  "minimap": {
    "show": "never",
    "thumb": "always"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    }
  },
  "hover_popover_delay": 600,
  "cursor_blink": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "confirm_quit": true,
  "buffer_font_fallbacks": [
    "Menlo",
    "Monaco",
    "Courier New",
    "monospace"
  ],
  "buffer_font_family": "Fira Code",
  "file_types": {
    "BluespecSystemVerilog": [
      "*.ms"
    ]
  },
  "colorize_brackets": true,
  "linked_edits": true,
  "use_on_type_format": true,
  "show_edit_predictions": true,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "model": [
          "claude-fable-5-1[1m]",
          "opus[1m]"
        ]
      },
      "default_config_options": {
        "fast": false,
        "effort": "high",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark"
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 12.5
}
